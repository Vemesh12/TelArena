# Local PostgreSQL or Neon Serverless Postgres DB URL
# Local example: postgresql://postgres:password@localhost:5432/mbg_arena
# Neon DB example: postgresql://user:password@ep-cool-name.ap-southeast-1.aws.neon.tech/mbg_arena?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/mbg_arena"

# Redis URL (Optional for local dev)
REDIS_URL="redis://localhost:6379"

# Discord OAuth
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
DISCORD_CALLBACK_URL="http://localhost:3001/auth/discord/callback"

# JWT
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# App
PORT=3001
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# File Storage (R2 / S3-compatible)
STORAGE_ENDPOINT="https://your-r2-endpoint.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY="YOUR_ACCESS_KEY"
STORAGE_SECRET_KEY="YOUR_SECRET_KEY"
STORAGE_BUCKET="mbg-arena"

# Supabase Storage Configuration (Optional alternative)
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_BUCKET="arena-bucket"

# Notifications
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK"
RESEND_API_KEY="re_YOUR_RESEND_KEY"

# OTP (MSG91)
MSG91_AUTH_KEY="YOUR_MSG91_KEY"
MSG91_TEMPLATE_ID="YOUR_TEMPLATE_ID"

# Telecom circle lookup (used by otp.service.ts lookupTelecomCircle)
TELECOM_API_KEY="YOUR_TELECOM_LOOKUP_API_KEY"
